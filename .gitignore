# Python / tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Project data: downloaded / user-supplied photos (third-party licences), satellite imagery (Esri terms),
# Blender files and GLB outputs. Never commit these.
projects/

# Images in reports are made from the photos and satellite imagery above
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.png
reports/**/*.webp

# Local settings / secrets (the tool keeps settings in ~/.landmark3d, outside the repo)
.env
*.blend
*.blend1
*.glb

# three.js viewer files downloaded by `landmark3d setup` (pinned version, see installer.py)
landmark3d/web/vendor/

# Local tool downloads (KTX-Software, validated by SHA-256 at install)
.tools/

# Photo pack downloaded for research (third-party licences); never commit
tmp/
